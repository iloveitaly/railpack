#!/usr/bin/env bash
#MISE description="Verify CLI environment variables and build secrets through prepare, build, and container startup"
#MISE timeout="10m"
#USAGE flag "--platform <platform>" help="Target platform for a remote Docker builder"

set -euo pipefail

example_directory="examples/shell-script"
environment_value="cli-env-value"
build_secret_value="cli-build-secret"
expected_output="env-and-secrets-ok"
plan_directory=$(mktemp -d -p "$TMP_DIR")
platform_arguments=()
if [[ -n "${usage_platform:-}" ]]; then
  platform_arguments=(--platform "$usage_platform")
fi

# compare a hash so the expected secret value is never embedded in the plan
build_command='test "$RAILPACK_E2E_ENV" = cli-env-value &&
test "$(printf %s "$RAILPACK_E2E_SECRET" | sha256sum | cut -d " " -f 1)" = 5d37fffc5ad38a6523a2e41565c80f67d8c3e176d2e07a41a528bf0bcc352642'
start_command='test "$RAILPACK_E2E_ENV" = cli-env-value && test "${RAILPACK_E2E_SECRET+x}" != x && echo env-and-secrets-ok'

# TODO(stable): in 1.0, remove --future-env and replace this compatibility loop with one
# case covering the default --env/--secret behavior
for environment_mode in mixed future; do
  image_name="railpack-cli-env-secrets:$environment_mode"
  plan_file="$plan_directory/$environment_mode-plan.json"
  info_file="$plan_directory/$environment_mode-info.json"
  environment_flags=(
    --env "RAILPACK_E2E_ENV=$environment_value"
    --secret "RAILPACK_E2E_SECRET=$build_secret_value"
    --build-cmd "$build_command"
    --start-cmd "$start_command"
  )
  if [[ "$environment_mode" == future ]]; then
    environment_flags+=(--future-env)
  fi

  echo "Testing CLI environment variables and secrets: $environment_mode"
  mise run cli prepare "$example_directory" "${environment_flags[@]}" \
    --plan-out "$plan_file" \
    --info-out "$info_file"

  jq -e '.success == true' "$info_file" > /dev/null
  jq -e --arg value "$environment_value" '
    .secrets == ["RAILPACK_E2E_SECRET"] and
    (.steps | all(
      .variables.RAILPACK_E2E_ENV == $value and
      (.variables | has("RAILPACK_E2E_SECRET") | not)
    )) and
    .deploy.variables.RAILPACK_E2E_ENV == $value and
    (.deploy.variables | has("RAILPACK_E2E_SECRET") | not)
  ' "$plan_file" > /dev/null
  jq -e -s --arg value "$build_secret_value" '
    all(.. | strings; contains($value) | not)
  ' "$plan_file" "$info_file" > /dev/null

  mise run cli build "$example_directory" "${environment_flags[@]}" \
    "${platform_arguments[@]}" \
    --name "$image_name"

  container_output=$(docker run --rm "${platform_arguments[@]}" "$image_name")
  echo "$container_output"
  [[ "$container_output" == "$expected_output" ]]
done
