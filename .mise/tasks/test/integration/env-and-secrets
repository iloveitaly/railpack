#!/usr/bin/env bash
#MISE description="Verify CLI environment variables and build secrets through prepare, build, and container startup"
#MISE timeout="10m"
#USAGE flag "--platform <platform>" help="Target platform for a remote Docker builder"

set -euo pipefail

example_dir="examples/shell-script"
env_value="cli-env-value"
secret_value="cli-build-secret"
expected_output="env-and-secrets-ok"
plan_dir=$(mktemp -d -p "$TMP_DIR")
platform_args=()
if [[ -n "${usage_platform:-}" ]]; then
  platform_args=(--platform "$usage_platform")
fi

# Compare a hash so the expected secret value is never embedded in the plan.
build_cmd='test "$RAILPACK_E2E_ENV" = cli-env-value &&
test "$(printf %s "$RAILPACK_E2E_SECRET" | sha256sum | cut -d " " -f 1)" = 5d37fffc5ad38a6523a2e41565c80f67d8c3e176d2e07a41a528bf0bcc352642'
start_cmd='test "$RAILPACK_E2E_ENV" = cli-env-value && test "${RAILPACK_E2E_SECRET+x}" != x && echo env-and-secrets-ok'

# TODO(stable): In 1.0, remove --future-env and replace this mode loop with one
# case covering the default --env/--secret behavior
for mode in mixed future; do
  image_name="railpack-cli-env-secrets:$mode"
  plan_file="$plan_dir/$mode-plan.json"
  info_file="$plan_dir/$mode-info.json"
  flags=(
    --env "RAILPACK_E2E_ENV=$env_value"
    --secret "RAILPACK_E2E_SECRET=$secret_value"
    --build-cmd "$build_cmd"
    --start-cmd "$start_cmd"
  )
  if [[ "$mode" == future ]]; then
    flags+=(--future-env)
  fi

  echo "Testing CLI environment variables and secrets: $mode"
  mise run cli prepare "$example_dir" "${flags[@]}" \
    --plan-out "$plan_file" \
    --info-out "$info_file"

  jq -e '.success == true' "$info_file" > /dev/null
  jq -e --arg value "$env_value" '
    .secrets == ["RAILPACK_E2E_SECRET"] and
    (.steps | all(
      .variables.RAILPACK_E2E_ENV == $value and
      (.variables | has("RAILPACK_E2E_SECRET") | not)
    )) and
    .deploy.variables.RAILPACK_E2E_ENV == $value and
    (.deploy.variables | has("RAILPACK_E2E_SECRET") | not)
  ' "$plan_file" > /dev/null
  jq -e -s --arg value "$secret_value" '
    all(.. | strings; contains($value) | not)
  ' "$plan_file" "$info_file" > /dev/null

  mise run cli build "$example_dir" "${flags[@]}" \
    "${platform_args[@]}" \
    --name "$image_name"

  output=$(docker run --rm "${platform_args[@]}" "$image_name")
  echo "$output"
  [[ "$output" == "$expected_output" ]]
done
